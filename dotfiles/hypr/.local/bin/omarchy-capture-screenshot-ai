#!/bin/bash

# omarchy:summary=Take an AI-optimized screenshot (downscaled to max 1280px, copied to clipboard and file)
# omarchy:group=capture
# omarchy:args=[smart|region|windows|fullscreen]
# omarchy:examples=omarchy-capture-screenshot-ai | omarchy-capture-screenshot-ai fullscreen

[[ -f ~/.config/user-dirs.dirs ]] && source ~/.config/user-dirs.dirs
OUTPUT_DIR="${OMARCHY_SCREENSHOT_DIR:-${XDG_PICTURES_DIR:-$HOME/Pictures}}"

if [[ ! -d $OUTPUT_DIR ]]; then
  mkdir -p "$OUTPUT_DIR"
fi

pkill slurp && exit 0

MODE="${1:-smart}"
FILENAME="screenshot-ai-$(date +'%Y-%m-%d_%H-%M-%S').png"
FILEPATH="$OUTPUT_DIR/$FILENAME"
TMPPATH="/tmp/screenshot-ai.png"

NO_HW_CURSORS=$(hyprctl getoption cursor:no_hardware_cursors -j | jq '.int')

set_no_hw_cursors() {
  hyprctl eval "hl.config({ cursor = { no_hardware_cursors = $1 } })" &>/dev/null ||
    hyprctl keyword cursor:no_hardware_cursors "$1" &>/dev/null
}

cleanup() {
  [[ -n $FREEZE_PID ]] && kill $FREEZE_PID 2>/dev/null
  set_no_hw_cursors "$NO_HW_CURSORS"
}
trap cleanup EXIT

set_no_hw_cursors 0
{ read -r FREEZE_PID; read -r SELECTION; } < <(omarchy-capture-region "$MODE" --keep-freeze)

[[ -z $SELECTION ]] && exit 0

# Capture and resize down to max 1280px width/height while preserving aspect ratio
grim -g "$SELECTION" - | magick - -resize "1280x>" "$FILEPATH" || exit 1

# Provide convenient constant path for agents
cp -f "$FILEPATH" "$TMPPATH"

# Copy to Wayland clipboard
wl-copy --type image/png <"$FILEPATH"

omarchy-notification-send "Capture IA prête" "Image optimisée (max 1280px) copiée dans le presse-papier" \
  --image "$FILEPATH" -t 2500 || true
